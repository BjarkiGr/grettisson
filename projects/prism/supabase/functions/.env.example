# PRISM — Edge Function secrets template
# Production: supabase secrets set NAME=value   (stored encrypted by Supabase)
# Local dev:  supabase functions serve --env-file ./supabase/functions/.env
# NEVER commit a real .env file. NEVER expose these values to the frontend.

# Automatically injected by the Supabase hosted runtime (do not set manually
# in production; needed only for local development):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# AI provider (configured in Phase 4 — free-tier providers only):
AI_PROVIDER=
AI_API_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=2048
