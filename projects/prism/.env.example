# PRISM — environment template (copy values, NEVER commit real secrets)
#
# FRONTEND (public by design, protected by Row Level Security):
# The frontend has no build step and does not read .env files. Put these two
# PUBLIC values into frontend/js/config.js when the Supabase project exists
# (Phase 2). The anon key is safe to expose ONLY with RLS enabled.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# BACKEND secrets are NOT stored here in production. Set them with:
#   supabase secrets set NAME=value
# See supabase/functions/.env.example for the full backend secret list.
